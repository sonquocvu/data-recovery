<UserControl x:Class="DataRecoveryStudio.App.Views.ScanProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="48" MaxWidth="880" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Style="{StaticResource PanelStyle}" Padding="42">
            <StackPanel>
                <Border Width="68" Height="68" CornerRadius="20" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Center">
                    <TextBlock Text="⌁" FontSize="34" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding DataContext.Localization.ScanProgressTitle, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PageTitleStyle}" HorizontalAlignment="Center" Margin="0,22,0,0" />
                <TextBlock Text="{Binding SourceName}" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" />
                <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="9" Padding="12,7" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <TextBlock Text="{Binding DataContext.Localization.MockEstimate, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" />
                </Border>
                <TextBlock Text="{Binding Phase}" FontSize="15" FontWeight="SemiBold" Margin="0,34,0,12" />
                <ProgressBar Value="{Binding Percentage}" Maximum="100" Height="10" />
                <TextBlock Text="{Binding Percentage, StringFormat={}{0:0}%}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{DynamicResource AccentTextBrush}" />
                <UniformGrid Columns="4" Margin="0,30,0,0">
                    <StackPanel><TextBlock Text="SCANNED" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding AmountScanned}" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                    <StackPanel><TextBlock Text="ELAPSED" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding ElapsedText}" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                    <StackPanel><TextBlock Text="REMAINING" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding RemainingText}" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                    <StackPanel><TextBlock Text="FILES FOUND" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding FilesFound, StringFormat=N0}" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
                </UniformGrid>
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,30,0,22" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="{Binding DataContext.Localization.Pause, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="False" Margin="0,0,10,0" />
                    <Button Content="{Binding DataContext.Localization.Cancel, RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding CancelCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
