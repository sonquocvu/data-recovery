<UserControl x:Class="DataRecoveryStudio.App.Views.ScanModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:DataRecoveryStudio.Core;assembly=DataRecoveryStudio.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="{StaticResource PageMargin}" MaxWidth="980" HorizontalAlignment="Center">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <Button Command="{Binding BackCommand}" HorizontalAlignment="Left" Padding="11,6" AutomationProperties.Name="{Binding DataContext.Localization[Action.Back], RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconArrowLeft}" Style="{StaticResource IconPathStyle}" Width="15" Height="15" /><TextBlock Text="{Binding DataContext.Localization[Action.Back], RelativeSource={RelativeSource AncestorType=Window}}" Margin="7,0,0,0" /></StackPanel>
            </Button>
            <TextBlock Text="{Binding DataContext.Localization[ScanMode.Title], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PageTitleStyle}" Margin="0,20,0,0" />
            <TextBlock Text="{Binding DataContext.Localization[ScanMode.Subtitle], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PageSubtitleStyle}" Margin="0,7,0,0" MaxWidth="720" HorizontalAlignment="Left" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource SubtlePanelStyle}" Margin="0,18,0,18" Padding="14,11">
            <Grid>
                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconDrive}" Style="{StaticResource IconPathStyle}" Width="17" Height="17" /><TextBlock Text="{Binding DataContext.Localization[Device.SelectedSummary], RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="9,0,0,0" /><TextBlock Text="{Binding SourceName}" Margin="9,0,0,0" FontWeight="SemiBold" /></StackPanel>
                <TextBlock Text="{Binding DataContext.Localization[ScanMode.NoGuarantee], RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Right" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SelectableCardStyle}" Tag="{Binding IsStandardSelected}" Padding="26">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid><Border Width="50" Height="50" CornerRadius="{StaticResource RadiusLarge}" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Left"><Path Data="{StaticResource IconScanFast}" Style="{StaticResource IconPathStyle}" Stroke="{DynamicResource AccentTextBrush}" Width="27" Height="27" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><Path Data="{StaticResource IconCheck}" Style="{StaticResource IconPathStyle}" Stroke="{DynamicResource PositiveBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding IsStandardSelected, Converter={StaticResource BoolToVisibilityConverter}}" /></Grid>
                    <TextBlock Grid.Row="1" Text="{Binding DataContext.Localization[ScanMode.Standard], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SectionTitleStyle}" Margin="0,20,0,0" />
                    <TextBlock Grid.Row="2" Text="{Binding DataContext.Localization[ScanMode.StandardBody], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PageSubtitleStyle}" Margin="0,9,0,18" />
                    <Border Grid.Row="3" Background="{DynamicResource PositiveSubtleBrush}" CornerRadius="{StaticResource RadiusSmall}" Padding="10,7"><TextBlock Text="{Binding DataContext.Localization[ScanMode.StandardTradeoff], RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource PositiveBrush}" FontSize="11" /></Border>
                    <Button Grid.Row="4" Content="{Binding DataContext.Localization[Action.Select], RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,20,0,0" Command="{Binding SelectModeCommand}" CommandParameter="{x:Static core:ScanModeKind.Standard}" />
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource SelectableCardStyle}" Tag="{Binding IsDeepSelected}" Padding="26">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid><Border Width="50" Height="50" CornerRadius="{StaticResource RadiusLarge}" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Left"><Path Data="{StaticResource IconScanDeep}" Style="{StaticResource IconPathStyle}" Stroke="{DynamicResource AccentTextBrush}" Width="27" Height="27" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><Path Data="{StaticResource IconCheck}" Style="{StaticResource IconPathStyle}" Stroke="{DynamicResource PositiveBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding IsDeepSelected, Converter={StaticResource BoolToVisibilityConverter}}" /></Grid>
                    <TextBlock Grid.Row="1" Text="{Binding DataContext.Localization[ScanMode.Deep], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SectionTitleStyle}" Margin="0,20,0,0" />
                    <TextBlock Grid.Row="2" Text="{Binding DataContext.Localization[ScanMode.DeepBody], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PageSubtitleStyle}" Margin="0,9,0,18" />
                    <Border Grid.Row="3" Background="{DynamicResource WarningSubtleBrush}" CornerRadius="{StaticResource RadiusSmall}" Padding="10,7"><TextBlock Text="{Binding DataContext.Localization[ScanMode.DeepTradeoff], RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource WarningBrush}" FontSize="11" /></Border>
                    <Button Grid.Row="4" Content="{Binding DataContext.Localization[Action.Select], RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,20,0,0" Command="{Binding SelectModeCommand}" CommandParameter="{x:Static core:ScanModeKind.Deep}" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Border Background="{DynamicResource WarningSubtleBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="13,10" HorizontalAlignment="Left" MaxWidth="650">
                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconWarning}" Style="{StaticResource IconPathStyle}" Stroke="{DynamicResource WarningBrush}" Width="17" Height="17" /><TextBlock Text="{Binding DataContext.Localization[Safety.StopUsing], RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource WarningBrush}" Margin="9,0,0,0" TextWrapping="Wrap" /></StackPanel>
            </Border>
            <Button Content="{Binding DataContext.Localization[Action.StartScan], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartScanCommand}" HorizontalAlignment="Right" MinWidth="190" />
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
