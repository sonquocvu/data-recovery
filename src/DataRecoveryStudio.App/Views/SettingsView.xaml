<UserControl x:Class="DataRecoveryStudio.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="{Binding DataContext.Localization[Settings.Title], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{Binding DataContext.Localization[Settings.Subtitle], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PageSubtitleStyle}" Margin="0,8,0,24" />

            <Border Style="{StaticResource PanelStyle}" Padding="22" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{Binding DataContext.Localization[Settings.Appearance], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{Binding DataContext.Localization[Settings.AppearanceBody], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PageSubtitleStyle}" Margin="0,6,24,0" /></StackPanel>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeChoices}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Theme}" VerticalAlignment="Center" AutomationProperties.Name="{Binding DataContext.Localization[Settings.Appearance], RelativeSource={RelativeSource AncestorType=Window}}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource PanelStyle}" Padding="22" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{Binding DataContext.Localization[Settings.Language], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{Binding DataContext.Localization[Settings.LanguageBody], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PageSubtitleStyle}" Margin="0,6,24,0" /></StackPanel>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Code" SelectedValue="{Binding LanguageCode}" VerticalAlignment="Center" AutomationProperties.Name="{Binding DataContext.Localization[Settings.Language], RelativeSource={RelativeSource AncestorType=Window}}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource PanelStyle}" Padding="22" Visibility="{Binding IsDevelopmentMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DataContext.Localization[Settings.Development], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SectionTitleStyle}" />
                        <Border Background="{DynamicResource WarningSubtleBrush}" CornerRadius="{StaticResource RadiusSmall}" Padding="8,4" Margin="10,0,0,0"><TextBlock Text="{Binding DataContext.Localization[Settings.DevelopmentBadge], RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource WarningBrush}" FontSize="9" FontWeight="SemiBold" /></Border>
                    </StackPanel>
                    <TextBlock Text="{Binding DataContext.Localization[Settings.DevelopmentBody], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PageSubtitleStyle}" Margin="0,7,0,16" />
                    <WrapPanel>
                        <Button Content="{Binding DataContext.Localization[Settings.State.Completed], RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,8,8" Command="{Binding DataContext.Results.SetDemoStateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Completed" />
                        <Button Content="{Binding DataContext.Localization[Settings.State.Empty], RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,8,8" Command="{Binding DataContext.Results.SetDemoStateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Empty" />
                        <Button Content="{Binding DataContext.Localization[Settings.State.Loading], RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,8,8" Command="{Binding DataContext.Results.SetDemoStateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Loading" />
                        <Button Content="{Binding DataContext.Localization[Settings.State.Canceled], RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,8,8" Command="{Binding DataContext.Results.SetDemoStateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Canceled" />
                        <Button Content="{Binding DataContext.Localization[Settings.State.Failed], RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,8,8" Command="{Binding DataContext.Results.SetDemoStateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Failed" />
                    </WrapPanel>
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,10,0,16" />
                    <Button Content="{Binding DataContext.Localization[Settings.GenerateLarge], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding DataContext.ShowLargeDatasetCommand, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
