<UserControl x:Class="DataRecoveryStudio.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="SettingsView_SizeChanged">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="{StaticResource PageMargin}" MaxWidth="1000" HorizontalAlignment="Center">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding DataContext.Localization[Settings.Title], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding DataContext.Localization[Settings.Subtitle], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PageSubtitleStyle}" Margin="0,8,0,24" MaxWidth="760" HorizontalAlignment="Left" />
            </StackPanel>

            <UniformGrid x:Name="SettingsCards" Grid.Row="1" Columns="2" Rows="1">
                <Border Style="{StaticResource PanelStyle}" Padding="24" Margin="0,0,8,16" MinHeight="210">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border Width="42" Height="42" CornerRadius="{StaticResource RadiusMedium}" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Left"><Path Data="{StaticResource IconPalette}" Style="{StaticResource IconPathStyle}" Stroke="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <StackPanel Grid.Row="1" Margin="0,14,0,18">
                            <TextBlock Text="{Binding DataContext.Localization[Settings.Appearance], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding DataContext.Localization[Settings.AppearanceBody], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PageSubtitleStyle}" Margin="0,6,0,0" />
                        </StackPanel>
                        <ComboBox x:Name="ThemeComboBox" Grid.Row="2" ItemsSource="{Binding ThemeChoices}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Theme}" AutomationProperties.Name="{Binding DataContext.Localization[Settings.Appearance], RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource PanelStyle}" Padding="24" Margin="8,0,0,16" MinHeight="210">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border Width="42" Height="42" CornerRadius="{StaticResource RadiusMedium}" Background="{DynamicResource InformationSubtleBrush}" HorizontalAlignment="Left"><Path Data="{StaticResource IconGlobe}" Style="{StaticResource IconPathStyle}" Stroke="{DynamicResource InformationBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <StackPanel Grid.Row="1" Margin="0,14,0,18">
                            <TextBlock Text="{Binding DataContext.Localization[Settings.Language], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding DataContext.Localization[Settings.LanguageBody], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PageSubtitleStyle}" Margin="0,6,0,0" />
                        </StackPanel>
                        <ComboBox x:Name="LanguageComboBox" Grid.Row="2" ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Code" SelectedValue="{Binding LanguageCode}" AutomationProperties.Name="{Binding DataContext.Localization[Settings.Language], RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Grid>
                </Border>
            </UniformGrid>

            <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Padding="22" Visibility="{Binding IsDevelopmentMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DataContext.Localization[Settings.Development], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SectionTitleStyle}" />
                        <Border Background="{DynamicResource WarningSubtleBrush}" CornerRadius="{StaticResource RadiusSmall}" Padding="8,4" Margin="10,0,0,0"><TextBlock Text="{Binding DataContext.Localization[Settings.DevelopmentBadge], RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource WarningBrush}" FontSize="9" FontWeight="SemiBold" /></Border>
                    </StackPanel>
                    <TextBlock Text="{Binding DataContext.Localization[Settings.DevelopmentBody], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PageSubtitleStyle}" Margin="0,7,0,16" />
                    <WrapPanel>
                        <Button Content="{Binding DataContext.Localization[Settings.State.Completed], RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,8,8" Command="{Binding DataContext.Results.SetDemoStateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Completed" />
                        <Button Content="{Binding DataContext.Localization[Settings.State.Empty], RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,8,8" Command="{Binding DataContext.Results.SetDemoStateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Empty" />
                        <Button Content="{Binding DataContext.Localization[Settings.State.Loading], RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,8,8" Command="{Binding DataContext.Results.SetDemoStateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Loading" />
                        <Button Content="{Binding DataContext.Localization[Settings.State.Canceled], RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,8,8" Command="{Binding DataContext.Results.SetDemoStateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Canceled" />
                        <Button Content="{Binding DataContext.Localization[Settings.State.Failed], RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,8,8" Command="{Binding DataContext.Results.SetDemoStateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Failed" />
                    </WrapPanel>
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,10,0,16" />
                    <Button Content="{Binding DataContext.Localization[Settings.GenerateLarge], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding DataContext.ShowLargeDatasetCommand, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
