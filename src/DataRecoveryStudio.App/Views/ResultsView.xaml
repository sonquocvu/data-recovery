<UserControl x:Class="DataRecoveryStudio.App.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="30,26,30,28">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="{Binding DataContext.Localization.ResultsTitle, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding DataContext.Localization.ResultsSubtitle, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PageSubtitleStyle}" Margin="0,7,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding SelectedCount, StringFormat={}{0} selected}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0" />
                <Button Content="{Binding DataContext.Localization.RecoverSelected, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource PrimaryButtonStyle}" Click="Recover_Click" IsEnabled="{Binding CanRecover}"
                        AutomationProperties.Name="Choose a safe recovery destination" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="290" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="{Binding DataContext.Localization.Filters, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" Margin="6,2,0,12" />
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Style="{StaticResource NavButtonStyle}" Margin="0,1"
                                        Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="4,16" />
                    <TextBlock Text="VISIBLE" Style="{StaticResource MetricLabelStyle}" Margin="6,0,0,0" />
                    <TextBlock Text="{Binding VisibleCount, StringFormat={}{0:N0} mock files}" FontWeight="SemiBold" Margin="6,5,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelStyle}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="14,10">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search mock recovery results" />
                        <TextBlock Text="Search names or folders" Foreground="{DynamicResource TextTertiaryBrush}" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortBy}" AutomationProperties.Name="Sort recovery results" />
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding VisibleResults}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              AutoGenerateColumns="False" SelectionMode="Extended" SelectionUnit="FullRow" IsReadOnly="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="42" Header="✓" />
                            <DataGridTextColumn Binding="{Binding Name}" Header="Name" Width="2*" IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding Category}" Header="Type" Width="80" IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding Size}" Header="Size" Width="78" IsReadOnly="True" />
                            <DataGridTextColumn Binding="{Binding Status}" Header="Recovery estimate" Width="118" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar IsIndeterminate="True" Width="180" /><TextBlock Text="Loading mock result catalog…" Margin="0,16,0,0" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
                    </Border>
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="○" FontSize="34" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" /><TextBlock Text="No mock results to display" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Text="Run a mock scan or choose another filter." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0" /></StackPanel>
                    </Border>
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Visibility="{Binding IsCanceled, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Scan canceled safely" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="The mock scan stopped without touching a device." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" /></StackPanel>
                    </Border>
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Mock scan failed" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource CriticalBrush}" /><TextBlock Text="This development state demonstrates graceful error handling." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" /></StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource PanelStyle}" Padding="20">
                <Grid>
                    <TextBlock Text="{Binding DataContext.Localization.SelectPrompt, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding SelectedItem}">
                            <TextBlock Text="{Binding DataContext.Localization.Preview, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource EyebrowTextStyle}" />
                            <Border Height="170" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="10" Margin="0,14,0,18">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="◇" FontSize="44" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" /><TextBlock Text="Mock preview" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" /></StackPanel>
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PreviewDescription}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,20" />
                            <TextBlock Text="ORIGINAL FOLDER" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding OriginalPath}" TextWrapping="Wrap" Margin="0,5,0,15" />
                            <TextBlock Text="SIZE" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding Size}" Margin="0,5,0,15" />
                            <TextBlock Text="LAST MODIFIED" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding Modified}" Margin="0,5,0,15" />
                            <TextBlock Text="RECOVERABILITY" Style="{StaticResource MetricLabelStyle}" />
                            <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="8" Padding="9,6" HorizontalAlignment="Left" Margin="0,6,0,0"><TextBlock Text="{Binding Status, StringFormat={}{0} · mock estimate}" Foreground="{DynamicResource AccentTextBrush}" /></Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
