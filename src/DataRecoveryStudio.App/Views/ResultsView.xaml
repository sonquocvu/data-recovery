<UserControl x:Class="DataRecoveryStudio.App.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,22,24,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="{Binding DataContext.Localization[Results.Title], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding DataContext.Localization[Results.Subtitle], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PageSubtitleStyle}" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold"><Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding DataContext.Localization[Results.SelectedFiles], RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" /></TextBlock>
                    <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"><Run Text="{Binding SelectedSize, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DataContext.Localization[Results.EstimatedSize], RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" /></TextBlock>
                </StackPanel>
                <Button Content="{Binding DataContext.Localization[Action.Recover], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButtonStyle}" Click="Recover_Click" IsEnabled="{Binding CanRecover}" MinWidth="150" AutomationProperties.Name="{Binding DataContext.Localization[Action.Recover], RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Padding="12">
                <StackPanel>
                    <TextBlock Text="{Binding DataContext.Localization[Results.Filters], RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" Margin="7,3,0,10" />
                    <ItemsControl ItemsSource="{Binding CategoryOptions}">
                        <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding DisplayName}" Style="{StaticResource NavButtonStyle}" Margin="0,1" Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Value}" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="5,14" />
                    <TextBlock Text="{Binding DataContext.Localization[Results.Visible], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MetricLabelStyle}" Margin="7,0,0,0" />
                    <TextBlock Margin="7,4,0,0"><Run Text="{Binding VisibleCount, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding DataContext.Localization[Results.MockFiles], RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" /></TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelStyle}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="12,9">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition Width="138" /></Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding DataContext.Localization[Results.Search], RelativeSource={RelativeSource AncestorType=Window}}" />
                            <TextBlock Text="{Binding DataContext.Localization[Results.Search], RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding SortChoices}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding SortBy}" AutomationProperties.Name="{Binding DataContext.Localization[Results.Sort], RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding VisibleResults}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" AutoGenerateColumns="False" SelectionMode="Extended" SelectionUnit="FullRow" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="38"><DataGridCheckBoxColumn.Header><TextBlock Text="{Binding DataContext.Localization[Results.Column.Select], RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" /></DataGridCheckBoxColumn.Header></DataGridCheckBoxColumn>
                            <DataGridTemplateColumn Width="2*"><DataGridTemplateColumn.Header><TextBlock Text="{Binding DataContext.Localization[Results.Column.Name], RelativeSource={RelativeSource AncestorType=Window}}" /></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="68"><DataGridTemplateColumn.Header><TextBlock Text="{Binding DataContext.Localization[Results.Column.Type], RelativeSource={RelativeSource AncestorType=Window}}" /></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Category}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Category}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding Size}" Width="67" IsReadOnly="True"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[Results.Column.Size], RelativeSource={RelativeSource AncestorType=Window}}" /></DataGridTextColumn.Header></DataGridTextColumn>
                            <DataGridTemplateColumn Width="116"><DataGridTemplateColumn.Header><TextBlock Text="{Binding DataContext.Localization[Results.Column.Recoverability], RelativeSource={RelativeSource AncestorType=Window}}" /></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Grid Width="10" Height="10" Margin="0,0,6,0"><Ellipse Fill="{DynamicResource RecoverabilityExcellentBrush}" Visibility="{Binding IsExcellent, Converter={StaticResource BoolToVisibilityConverter}}" /><Ellipse Fill="{DynamicResource RecoverabilityGoodBrush}" Visibility="{Binding IsGood, Converter={StaticResource BoolToVisibilityConverter}}" /><Ellipse Fill="{DynamicResource RecoverabilityPoorBrush}" Visibility="{Binding IsPoor, Converter={StaticResource BoolToVisibilityConverter}}" /><Ellipse Fill="{DynamicResource RecoverabilityUnknownBrush}" Visibility="{Binding IsUnknown, Converter={StaticResource BoolToVisibilityConverter}}" /></Grid><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar IsIndeterminate="True" Width="170" /><TextBlock Text="{Binding DataContext.Localization[Results.LoadingTitle], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SectionTitleStyle}" Margin="0,16,0,0" /><TextBlock Text="{Binding DataContext.Localization[Results.LoadingBody], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PageSubtitleStyle}" Margin="0,5,0,0" /></StackPanel></Border>
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="{StaticResource IconEmpty}" Style="{StaticResource IconPathStyle}" Width="34" Height="34" Stroke="{DynamicResource TextTertiaryBrush}" /><TextBlock Text="{Binding DataContext.Localization[Results.EmptyTitle], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SectionTitleStyle}" Margin="0,13,0,0" /><TextBlock Text="{Binding DataContext.Localization[Results.EmptyBody], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PageSubtitleStyle}" Margin="0,5,0,0" /></StackPanel></Border>
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Visibility="{Binding IsCanceled, Converter={StaticResource BoolToVisibilityConverter}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="{StaticResource IconCheck}" Style="{StaticResource IconPathStyle}" Width="32" Height="32" Stroke="{DynamicResource PositiveBrush}" /><TextBlock Text="{Binding DataContext.Localization[Results.CanceledTitle], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SectionTitleStyle}" Margin="0,13,0,0" /><TextBlock Text="{Binding DataContext.Localization[Results.CanceledBody], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PageSubtitleStyle}" Margin="0,5,0,0" TextAlignment="Center" /></StackPanel></Border>
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibilityConverter}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="{StaticResource IconWarning}" Style="{StaticResource IconPathStyle}" Width="32" Height="32" Stroke="{DynamicResource CriticalBrush}" /><TextBlock Text="{Binding DataContext.Localization[Results.FailedTitle], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SectionTitleStyle}" Foreground="{DynamicResource CriticalBrush}" Margin="0,13,0,0" /><TextBlock Text="{Binding DataContext.Localization[Results.FailedBody], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PageSubtitleStyle}" Margin="0,5,0,0" TextAlignment="Center" /></StackPanel></Border>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource PanelStyle}" Padding="16">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="190">
                        <Path Data="{StaticResource IconFile}" Style="{StaticResource IconPathStyle}" Width="32" Height="32" Stroke="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Text="{Binding DataContext.Localization[Results.SelectPrompt], RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" />
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasSelectedItem}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasSelectedItem}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
                        <StackPanel DataContext="{Binding SelectedItem}">
                            <TextBlock Text="{Binding DataContext.Localization[Results.Preview], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource EyebrowTextStyle}" />
                            <Grid Height="150" Margin="0,12,0,16">
                                <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="{StaticResource RadiusMedium}" Visibility="{Binding HasSupportedPreview, Converter={StaticResource BoolToVisibilityConverter}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="{StaticResource IconFile}" Style="{StaticResource IconPathStyle}" Width="38" Height="38" Stroke="{DynamicResource AccentTextBrush}" /><TextBlock Text="{Binding DataContext.Localization[Preview.Mock], RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" /></StackPanel></Border>
                                <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="{StaticResource RadiusMedium}" Visibility="{Binding HasUnsupportedPreview, Converter={StaticResource BoolToVisibilityConverter}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"><Path Data="{StaticResource IconInfo}" Style="{StaticResource IconPathStyle}" Width="28" Height="28" Stroke="{DynamicResource TextTertiaryBrush}" /><TextBlock Text="{Binding DataContext.Localization[Preview.UnsupportedTitle], RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" Margin="0,8,0,0" TextAlignment="Center" /><TextBlock Text="{Binding DataContext.Localization[Preview.UnsupportedBody], RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" /></StackPanel></Border>
                                <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="{StaticResource RadiusMedium}" Visibility="{Binding HasMissingPreview, Converter={StaticResource BoolToVisibilityConverter}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"><Path Data="{StaticResource IconEmpty}" Style="{StaticResource IconPathStyle}" Width="28" Height="28" Stroke="{DynamicResource TextTertiaryBrush}" /><TextBlock Text="{Binding DataContext.Localization[Preview.MissingTitle], RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" Margin="0,8,0,0" TextAlignment="Center" /><TextBlock Text="{Binding DataContext.Localization[Preview.MissingBody], RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" /></StackPanel></Border>
                                <Border Background="{DynamicResource CriticalSubtleBrush}" CornerRadius="{StaticResource RadiusMedium}" Visibility="{Binding HasDamagedPreview, Converter={StaticResource BoolToVisibilityConverter}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"><Path Data="{StaticResource IconWarning}" Style="{StaticResource IconPathStyle}" Width="28" Height="28" Stroke="{DynamicResource CriticalBrush}" /><TextBlock Text="{Binding DataContext.Localization[Preview.DamagedTitle], RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" Foreground="{DynamicResource CriticalBrush}" Margin="0,8,0,0" TextAlignment="Center" /><TextBlock Text="{Binding DataContext.Localization[Preview.DamagedBody], RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" /></StackPanel></Border>
                            </Grid>
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding Name}" />
                            <TextBlock Text="{Binding PreviewDescription}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,16" />
                            <TextBlock Text="{Binding DataContext.Localization[Results.OriginalFolder], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding OriginalPath}" TextWrapping="Wrap" Margin="0,4,0,12" ToolTip="{Binding OriginalPath}" />
                            <TextBlock Text="{Binding DataContext.Localization[Results.Size], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding Size}" Margin="0,4,0,12" />
                            <TextBlock Text="{Binding DataContext.Localization[Results.Modified], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding Modified}" Margin="0,4,0,12" />
                            <TextBlock Text="{Binding DataContext.Localization[Results.Recoverability], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MetricLabelStyle}" /><Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="{StaticResource RadiusSmall}" Padding="8,5" HorizontalAlignment="Left" Margin="0,5,0,0"><TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap" /></Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
