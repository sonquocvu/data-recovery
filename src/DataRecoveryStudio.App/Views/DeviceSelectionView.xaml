<UserControl x:Class="DataRecoveryStudio.App.Views.DeviceSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:application="clr-namespace:DataRecoveryStudio.Application;assembly=DataRecoveryStudio.Application">
    <Grid Margin="{StaticResource PageMargin}" MaxWidth="1180" HorizontalAlignment="Center">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="{Binding DataContext.Localization[Device.Title], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding DataContext.Localization[Device.Subtitle], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PageSubtitleStyle}" Margin="0,8,0,0" MaxWidth="720" HorizontalAlignment="Left" />
            </StackPanel>
            <Button Command="{Binding RefreshCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.Name="{Binding DataContext.Localization[Action.Refresh], RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconPathStyle}" Width="16" Height="16" /><TextBlock Text="{Binding DataContext.Localization[Action.Refresh], RelativeSource={RelativeSource AncestorType=Window}}" Margin="8,0,0,0" /></StackPanel>
            </Button>
        </Grid>
        <Border Grid.Row="1" Margin="0,20,0,18" Background="{DynamicResource InformationSubtleBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="14,11">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconInfo}" Style="{StaticResource IconPathStyle}" Stroke="{DynamicResource InformationBrush}" Width="18" Height="18" />
                <TextBlock Text="{Binding DataContext.Localization[Device.SafePreview], RelativeSource={RelativeSource AncestorType=Window}}" Margin="10,0,0,0" Foreground="{DynamicResource InformationBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type application:DeviceCardViewModel}">
                        <Border Style="{StaticResource SelectableCardStyle}" Tag="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}" Width="342" Margin="0,0,14,14" Padding="18" MinHeight="242">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="{StaticResource RadiusMedium}" Background="{DynamicResource AccentSubtleBrush}" VerticalAlignment="Top">
                                        <Grid>
                                            <Path Data="{StaticResource IconDrive}" Style="{StaticResource IconPathStyle}" Stroke="{DynamicResource AccentTextBrush}" Visibility="{Binding IsInternal, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <Path Data="{StaticResource IconDrive}" Style="{StaticResource IconPathStyle}" Stroke="{DynamicResource AccentTextBrush}" Visibility="{Binding IsExternal, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <Path Data="{StaticResource IconUsb}" Style="{StaticResource IconPathStyle}" Stroke="{DynamicResource AccentTextBrush}" Visibility="{Binding IsRemovable, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="9,0,8,0">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                        <TextBlock Text="{Binding Type}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="{StaticResource RadiusSmall}" Padding="8,4" VerticalAlignment="Top">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource PositiveSubtleBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsAvailable}" Value="False"><Setter Property="Background" Value="{DynamicResource CriticalSubtleBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource PositiveBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsAvailable}" Value="False"><Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="0,18,0,14">
                                    <ProgressBar Value="{Binding UsedPercentage, Mode=OneWay}" Maximum="100" />
                                    <Grid Margin="0,6,0,0"><TextBlock Text="{Binding Used}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" /><TextBlock Text="{Binding Free}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" /></Grid>
                                </StackPanel>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="{Binding DataContext.Localization[Common.Capacity], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding Capacity}" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding DataContext.Localization[Common.Free], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding Free}" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="{Binding DataContext.Localization[Common.Format], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding FileSystem}" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel>
                                </Grid>
                                <Grid Grid.Row="3" Margin="0,18,0,0" VerticalAlignment="Bottom">
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Model}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Model}" /><TextBlock Text="{Binding MountPath}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10" Margin="0,2,0,0" /></StackPanel>
                                    <Button HorizontalAlignment="Right" Command="{Binding DataContext.SelectDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" MinWidth="88">
                                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                        <TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding DataContext.Localization[Action.Select], RelativeSource={RelativeSource AncestorType=Window}}" /><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Text" Value="{Binding DataContext.Localization[Action.Selected], RelativeSource={RelativeSource AncestorType=Window}}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                <Path Data="{StaticResource IconEmpty}" Style="{StaticResource IconPathStyle}" Width="36" Height="36" Stroke="{DynamicResource TextTertiaryBrush}" />
                <TextBlock Text="{Binding DataContext.Localization[Device.EmptyTitle], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                <TextBlock Text="{Binding DataContext.Localization[Device.EmptyBody], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PageSubtitleStyle}" TextAlignment="Center" Margin="0,7,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource ElevatedPanelStyle}" Padding="14" Margin="0,12,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <StackPanel><TextBlock Text="{Binding DataContext.Localization[Device.SelectedSummary], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding SelectedDevice.Name}" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel>
                <Button Content="{Binding DataContext.Localization[Action.Continue], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ContinueCommand}" HorizontalAlignment="Right" MinWidth="130" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
