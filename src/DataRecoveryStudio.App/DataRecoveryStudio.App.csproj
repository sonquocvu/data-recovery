<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DataRecoveryStudio.Core\DataRecoveryStudio.Core.csproj" />
    <ProjectReference Include="..\DataRecoveryStudio.Application\DataRecoveryStudio.Application.csproj" />
    <ProjectReference Include="..\DataRecoveryStudio.Infrastructure\DataRecoveryStudio.Infrastructure.csproj" />
    <ProjectReference Include="..\DataRecoveryStudio.ScanWorker\DataRecoveryStudio.ScanWorker.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DataRecoveryStudio</AssemblyName>
    <RootNamespace>DataRecoveryStudio.App</RootNamespace>
  </PropertyGroup>

  <Target Name="CopyScanWorkerToApplicationDirectory" AfterTargets="Build">
    <ItemGroup>
      <_ScanWorkerFiles Include="$(MSBuildProjectDirectory)\..\DataRecoveryStudio.ScanWorker\bin\$(Platform)\$(Configuration)\net8.0-windows\win-x64\DataRecoveryStudio.ScanWorker.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ScanWorkerFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
