<Window x:Class="DataRecoveryStudio.App.CancelConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title, Mode=OneWay}" Width="500" Height="260" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="{Binding Title, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Grid.Row="1" Text="{Binding Message, Mode=OneWay}" Style="{StaticResource PageSubtitleStyle}" Margin="0,14,0,20" TextWrapping="Wrap" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding NegativeLabel, Mode=OneWay}" IsCancel="True" MinWidth="130" Margin="0,0,10,0" />
            <Button Content="{Binding AffirmativeLabel, Mode=OneWay}" Style="{StaticResource DangerButtonStyle}" IsDefault="True" MinWidth="130" Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
