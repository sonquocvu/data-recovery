<Window x:Class="DataRecoveryStudio.App.RecoveryDestinationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose recovery destination" Width="650" Height="610" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="30">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Choose recovery destination" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="This is a validation-only Phase 1 dialog. No files will be written." Style="{StaticResource PageSubtitleStyle}" Margin="0,8,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource WarningSubtleBrush}" CornerRadius="10" Padding="15" Margin="0,22,0,18">
            <StackPanel Orientation="Horizontal"><TextBlock Text="⚠" FontSize="19" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Top" /><TextBlock Text="Never recover to the source physical device. A different drive letter on the same disk is still unsafe." Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="10,0,0,0" /></StackPanel>
        </Border>
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Destinations}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource SubtlePanelStyle}" Margin="0,0,0,10" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <RadioButton GroupName="Destination" VerticalAlignment="Center" Click="Destination_Click" Tag="{Binding}" AutomationProperties.Name="Select recovery destination" />
                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" /></StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="AVAILABLE" Style="{StaticResource MetricLabelStyle}" HorizontalAlignment="Right" /><TextBlock Text="{Binding Available}" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Right" /></StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Grid.Row="3" Style="{StaticResource SubtlePanelStyle}" Padding="14" Margin="0,12,0,18">
            <Grid>
                <StackPanel><TextBlock Text="SPACE REQUIRED" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding RequiredSpace}" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                <TextBlock Text="{Binding ValidationMessage}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap" MaxWidth="330" />
            </Grid>
        </Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,10,0" />
            <Button Content="Continue mock recovery" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding IsValid}" Click="Continue_Click" />
        </StackPanel>
    </Grid>
</Window>
