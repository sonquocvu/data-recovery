<Window x:Class="DataRecoveryStudio.App.RecoveryDestinationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Localization[Destination.Title]}" Width="660" Height="600" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        Loaded="Window_Loaded" UseLayoutRounding="True">
    <Grid Margin="28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding Localization[Destination.Title]}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{Binding Localization[Destination.Subtitle]}" Style="{StaticResource PageSubtitleStyle}" Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource SubtlePanelStyle}" Padding="13" Margin="0,18,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Path Data="{StaticResource IconDrive}" Style="{StaticResource IconPathStyle}" Stroke="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1"><TextBlock Text="{Binding Localization[Destination.Source]}" Style="{StaticResource MetricLabelStyle}" /><TextBlock Margin="0,4,0,0"><Run Text="{Binding SourceDisplayName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding SourceLocation, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" /></TextBlock></StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource InformationSubtleBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="13,10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconInfo}" Style="{StaticResource IconPathStyle}" Stroke="{DynamicResource InformationBrush}" Width="17" Height="17" VerticalAlignment="Top" /><TextBlock Text="{Binding Localization[Destination.Guidance]}" Foreground="{DynamicResource InformationBrush}" TextWrapping="Wrap" Margin="9,0,0,0" /></StackPanel>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Destinations}">
                <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource SelectableCardStyle}" Margin="0,0,0,9" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><RadioButton GroupName="Destination" VerticalAlignment="Center" Click="Destination_Click" Tag="{Binding}" AutomationProperties.Name="{Binding DisplayName}" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Path}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" /></StackPanel><StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{Binding DataContext.Localization[Destination.Available], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MetricLabelStyle}" HorizontalAlignment="Right" /><TextBlock Text="{Binding Available}" FontWeight="SemiBold" Margin="0,3,0,0" HorizontalAlignment="Right" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="4" Style="{StaticResource SubtlePanelStyle}" Padding="13" Margin="0,12,0,16" AutomationProperties.LiveSetting="Assertive">
            <Grid>
                <StackPanel><TextBlock Text="{Binding Localization[Destination.Required]}" Style="{StaticResource MetricLabelStyle}" /><TextBlock Text="{Binding RequiredSpace}" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" MaxWidth="390">
                    <Grid Width="16" Height="16" Margin="0,0,7,0"><Path Data="{StaticResource IconCheck}" Width="15" Height="15" Stroke="{DynamicResource PositiveBrush}"><Path.Style><Style TargetType="Path" BasedOn="{StaticResource IconPathStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsValid}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Path.Style></Path><Path Data="{StaticResource IconWarning}" Width="15" Height="15" Stroke="{DynamicResource CriticalBrush}"><Path.Style><Style TargetType="Path" BasedOn="{StaticResource IconPathStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsValid}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Path.Style></Path></Grid>
                    <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsValid}" Value="True"><Setter Property="Foreground" Value="{DynamicResource PositiveBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding Localization[Action.CancelDialog]}" IsCancel="True" Margin="0,0,10,0" MinWidth="100" />
            <Button Content="{Binding Localization[Action.ConfirmMockRecovery]}" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding IsValid}" Click="Continue_Click" MinWidth="190" />
        </StackPanel>
    </Grid>
</Window>
