<Window x:Class="DataRecoveryStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:application="clr-namespace:DataRecoveryStudio.Application;assembly=DataRecoveryStudio.Application"
        Title="{Binding Localization[App.Title]}" Icon="{StaticResource ApplicationIcon}" Width="1440" Height="900" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="188" /><ColumnDefinition Width="*" /><ColumnDefinition Width="188" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="{StaticResource RadiusMedium}" Background="{DynamicResource AccentBrush}">
                        <Path Data="{StaticResource IconShield}" Style="{StaticResource IconPathStyle}" Stroke="{DynamicResource TextOnAccentBrush}" Width="21" Height="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Localization[App.Title]}" Margin="10,0,0,0" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource AccentSubtleBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="10,5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Localization[App.Phase5BBadge], Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="208" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="12,18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel KeyboardNavigation.TabNavigation="Continue">
                        <TextBlock Text="{Binding Localization[App.Workspace]}" Style="{StaticResource EyebrowTextStyle}" Margin="12,0,0,10" />
                        <RadioButton Style="{StaticResource NavRadioButtonStyle}" GroupName="MainNavigation" IsChecked="{Binding IsDevicesSelected, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static application:PageKind.Devices}" AutomationProperties.Name="{Binding Localization[Nav.Devices]}">
                            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconDrive}" Style="{StaticResource IconPathStyle}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="{Binding Localization[Nav.Devices]}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="11,0,0,0" VerticalAlignment="Center" /></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavRadioButtonStyle}" GroupName="MainNavigation" IsChecked="{Binding IsResultsSelected, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static application:PageKind.Results}" AutomationProperties.Name="{Binding Localization[Nav.Results]}">
                            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconSearch}" Style="{StaticResource IconPathStyle}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="{Binding Localization[Nav.Results]}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="11,0,0,0" VerticalAlignment="Center" /></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavRadioButtonStyle}" GroupName="MainNavigation" IsChecked="{Binding IsSettingsSelected, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static application:PageKind.Settings}" AutomationProperties.Name="{Binding Localization[Nav.Settings]}">
                            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconSettings}" Style="{StaticResource IconPathStyle}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="{Binding Localization[Nav.Settings]}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="11,0,0,0" VerticalAlignment="Center" /></StackPanel>
                        </RadioButton>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="{Binding Localization[App.VersionPhase5B], Mode=OneWay}" Margin="12,0,0,0" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Bottom" />
                </Grid>
            </Border>
            <ContentControl Grid.Column="1" Content="{Binding CurrentPageViewModel}" KeyboardNavigation.TabNavigation="Continue" />
        </Grid>
    </Grid>
</Window>
