<Window x:Class="DataRecoveryStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:application="clr-namespace:DataRecoveryStudio.Application;assembly=DataRecoveryStudio.Application"
        Title="Data Recovery Studio" Width="1440" Height="900" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True">
    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="↺" FontSize="21" FontWeight="SemiBold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Localization.AppTitle}" Margin="10,0,0,0" FontWeight="SemiBold"
                                   FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource AccentSubtleBrush}" CornerRadius="12"
                            Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Localization.MockBadge}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextBrush}" />
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource WindowButtonStyle}" Content="—" ToolTip="Minimize" Click="Minimize_Click" />
                        <Button Style="{StaticResource WindowButtonStyle}" Content="□" ToolTip="Maximize or restore" Click="Maximize_Click" />
                        <Button Style="{StaticResource CloseWindowButtonStyle}" Content="×" ToolTip="Close" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
                    <Grid Margin="14,20">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="WORKSPACE" Style="{StaticResource EyebrowTextStyle}" Margin="12,0,0,10" />
                            <Button Style="{StaticResource NavButtonStyle}" Content="{Binding Localization.NavDevices}"
                                    Command="{Binding NavigateCommand}" CommandParameter="{x:Static application:PageKind.Devices}" />
                            <Button Style="{StaticResource NavButtonStyle}" Content="{Binding Localization.NavResults}"
                                    Command="{Binding NavigateCommand}" CommandParameter="{x:Static application:PageKind.Results}" />
                            <Button Style="{StaticResource NavButtonStyle}" Content="{Binding Localization.NavSettings}"
                                    Command="{Binding NavigateCommand}" CommandParameter="{x:Static application:PageKind.Settings}" />
                        </StackPanel>
                        <Border Grid.Row="2" Style="{StaticResource SubtlePanelStyle}" Padding="14">
                            <StackPanel>
                                <TextBlock Text="READ-ONLY FOUNDATION" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock Text="No real disks are accessed in this build." Margin="0,7,0,0" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <ContentControl Grid.Column="1" Content="{Binding CurrentPageViewModel}" />
            </Grid>
            <Border Grid.Row="2" Background="{DynamicResource StatusBarBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="18,0">
                    <TextBlock Text="{Binding Localization.SafetyNotice}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="v0.1.0 · Phase 1" FontSize="11" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
