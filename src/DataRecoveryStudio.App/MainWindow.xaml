<Window x:Class="DataRecoveryStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:application="clr-namespace:DataRecoveryStudio.Application;assembly=DataRecoveryStudio.Application"
        Title="{Binding Localization[App.Title]}" Width="1440" Height="900" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /><RowDefinition Height="32" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="188" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="{StaticResource RadiusMedium}" Background="{DynamicResource AccentBrush}">
                        <Path Data="{StaticResource IconShield}" Style="{StaticResource IconPathStyle}" Stroke="{DynamicResource TextOnAccentBrush}" Width="21" Height="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Localization[App.Title]}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{Binding Localization[App.ReadOnlyFoundation]}" Style="{StaticResource EyebrowTextStyle}" FontSize="9" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource AccentSubtleBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="10,5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Localization[App.MockBadge]}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" />
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconInfo}" Style="{StaticResource IconPathStyle}" Width="16" Height="16" Stroke="{DynamicResource InformationBrush}" />
                    <TextBlock Text="{Binding Localization[App.NoRealDisks]}" Margin="8,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="208" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="12,18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel KeyboardNavigation.TabNavigation="Continue">
                        <TextBlock Text="{Binding Localization[App.Workspace]}" Style="{StaticResource EyebrowTextStyle}" Margin="12,0,0,10" />
                        <Button Style="{StaticResource NavButtonStyle}" Tag="{Binding IsDevicesSelected}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static application:PageKind.Devices}" AutomationProperties.Name="{Binding Localization[Nav.Devices]}">
                            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconDrive}" Style="{StaticResource IconPathStyle}" /><TextBlock Text="{Binding Localization[Nav.Devices]}" Margin="11,0,0,0" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="{Binding IsResultsSelected}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static application:PageKind.Results}" AutomationProperties.Name="{Binding Localization[Nav.Results]}">
                            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconSearch}" Style="{StaticResource IconPathStyle}" /><TextBlock Text="{Binding Localization[Nav.Results]}" Margin="11,0,0,0" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="{Binding IsSettingsSelected}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static application:PageKind.Settings}" AutomationProperties.Name="{Binding Localization[Nav.Settings]}">
                            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconSettings}" Style="{StaticResource IconPathStyle}" /><TextBlock Text="{Binding Localization[Nav.Settings]}" Margin="11,0,0,0" VerticalAlignment="Center" /></StackPanel>
                        </Button>
                    </StackPanel>
                    <Border Grid.Row="2" Style="{StaticResource SubtlePanelStyle}" Padding="12">
                        <StackPanel>
                            <Path Data="{StaticResource IconShield}" Style="{StaticResource IconPathStyle}" Stroke="{DynamicResource PositiveBrush}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding Localization[App.NoRealDisks]}" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <ContentControl Grid.Column="1" Content="{Binding CurrentPageViewModel}" KeyboardNavigation.TabNavigation="Continue" />
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource StatusBarBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <TextBlock Text="{Binding Localization[Safety.Notice]}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Localization[App.Version]}" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
