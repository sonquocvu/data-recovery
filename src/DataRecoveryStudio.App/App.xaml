<Application x:Class="DataRecoveryStudio.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:application="clr-namespace:DataRecoveryStudio.Application;assembly=DataRecoveryStudio.Application"
             xmlns:views="clr-namespace:DataRecoveryStudio.App.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <DataTemplate DataType="{x:Type application:DeviceSelectionViewModel}"><views:DeviceSelectionView /></DataTemplate>
            <DataTemplate DataType="{x:Type application:ScanModeViewModel}"><views:ScanModeView /></DataTemplate>
            <DataTemplate DataType="{x:Type application:ScanProgressViewModel}"><views:ScanProgressView /></DataTemplate>
            <DataTemplate DataType="{x:Type application:ResultsViewModel}"><views:ResultsView /></DataTemplate>
            <DataTemplate DataType="{x:Type application:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
