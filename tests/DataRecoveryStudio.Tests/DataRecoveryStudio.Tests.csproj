<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DataRecoveryStudio.Core\DataRecoveryStudio.Core.csproj" />
    <ProjectReference Include="..\..\src\DataRecoveryStudio.Application\DataRecoveryStudio.Application.csproj" />
    <ProjectReference Include="..\..\src\DataRecoveryStudio.Infrastructure\DataRecoveryStudio.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\DataRecoveryStudio.App\DataRecoveryStudio.App.csproj" />
    <ProjectReference Include="..\..\src\DataRecoveryStudio.ScanWorker\DataRecoveryStudio.ScanWorker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyScanWorkerToTestDirectory" AfterTargets="Build">
    <ItemGroup>
      <_ScanWorkerFiles Include="$(MSBuildProjectDirectory)\..\..\src\DataRecoveryStudio.ScanWorker\bin\$(Platform)\$(Configuration)\net8.0-windows\win-x64\DataRecoveryStudio.ScanWorker.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ScanWorkerFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
